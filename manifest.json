{
  "manifest_version": 3,
  "name": "Nostr WoT",
  "version": "0.7.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "nostr-wot@dandelionlabs.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "financialAndPaymentInfo",
          "personallyIdentifyingInfo",
          "authenticationInfo",
          "personalCommunications",
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "description": "Nostr Web of Trust identity and wallet provider \u2014 NIP-07 signer and built-in Lightning wallet.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background.ts"
    ],
    "service_worker": "background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/entrypoints/popup/index.html",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.ts"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.ts"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-base.svg",
        "locales/en.json",
        "locales/es.json",
        "locales/pt.json",
        "locales/de.json",
        "locales/fr.json",
        "locales/it.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
